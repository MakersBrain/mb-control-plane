{
  "name": "@makersbrain/control-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:api": "cargo run --quiet --manifest-path ../Cargo.toml --bin control-openapi -- --typescript src/lib/generated/control-api.ts",
    "dev": "vite dev --port 4175",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
