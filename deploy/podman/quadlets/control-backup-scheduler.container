[Unit]
Description=MakersBrain encrypted backup scheduler
Requires=control-migrate.service control-container-driver.service
After=control-migrate.service control-container-driver.service

[Container]
Image=@@CONTROL_IMAGE@@
Pull=never
ContainerName=control-backup-scheduler
UserNS=keep-id:uid=10001,gid=10001
Network=makersbrain.network
Environment=CONTROL_DEPLOYMENT_ENVIRONMENT=@@ENVIRONMENT@@
Environment=PGSSLMODE=verify-full
Environment=PGSSLROOTCERT=/run/secrets/postgres-ca.crt
EnvironmentFile=/etc/makersbrain/control-backup-scheduler.env
Volume=/etc/makersbrain/secrets/control-backup-scheduler:/run/secrets:ro
Volume=@@RUNTIME_SECRET_SOURCE@@/postgres-ca.crt:/run/secrets/postgres-ca.crt:ro
Exec=/usr/local/bin/control-backup-scheduler
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
