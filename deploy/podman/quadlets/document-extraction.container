[Unit]
Description=MakersBrain document extraction broker
Requires=control-migrate.container
After=control-migrate.container

[Container]
Image=@@CONTROL_IMAGE@@
Pull=never
ContainerName=document-extraction
UserNS=keep-id:uid=10001,gid=10001
Network=makersbrain.network
EnvironmentFile=/etc/makersbrain/document-extraction.env
Volume=/etc/makersbrain/secrets/document-extraction:/run/secrets:ro
Exec=/usr/local/bin/document-extraction-broker
HealthCmd=/usr/bin/curl --fail --silent http://127.0.0.1:8080/health/live
HealthInterval=15s
HealthRetries=12
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=default.target
