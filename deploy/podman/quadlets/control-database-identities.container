[Unit]
Description=Reconcile MakersBrain PostgreSQL process identities
Before=control-migrate.container

[Container]
Image=@@POSTGRES_IMAGE@@
Pull=never
Network=makersbrain.network
Environment=PGSSLMODE=verify-full
Environment=PGSSLROOTCERT=/run/secrets/postgres-ca.crt
Environment=PGHOST=@@POSTGRES_HOST@@
EnvironmentFile=/etc/makersbrain/control-database-identities.env
Volume=./reconcile-database-identities.sh:/run/makersbrain/reconcile-database-identities.sh:ro
Volume=/etc/makersbrain/secrets/database-identities:/run/secrets:ro
Volume=@@RUNTIME_SECRET_SOURCE@@/postgres-ca.crt:/run/secrets/postgres-ca.crt:ro
Exec=/bin/sh /run/makersbrain/reconcile-database-identities.sh
NoNewPrivileges=true
DropCapability=all

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
