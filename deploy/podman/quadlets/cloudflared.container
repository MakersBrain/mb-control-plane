[Unit]
Description=MakersBrain outbound Cloudflare Tunnel connector
Requires=control-api.container control-web.container rauthy-ready.container tenant-gateway.container
After=control-api.container control-web.container rauthy-ready.container tenant-gateway.container

[Container]
Image=@@CLOUDFLARED_IMAGE@@
Pull=never
ContainerName=cloudflared
Network=makersbrain.network
Volume=/etc/makersbrain/secrets/cloudflared:/run/secrets:ro
Exec=tunnel --no-autoupdate --metrics 0.0.0.0:2000 run --token-file /run/secrets/tunnel-token
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=default.target
