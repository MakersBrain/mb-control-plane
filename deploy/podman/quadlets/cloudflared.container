[Unit]
Description=MakersBrain outbound Cloudflare Tunnel connector
Requires=control-api.service control-web.service rauthy-ready.service tenant-gateway.service
After=control-api.service control-web.service rauthy-ready.service tenant-gateway.service

[Container]
Image=@@CLOUDFLARED_IMAGE@@
Pull=never
ContainerName=cloudflared
UserNS=keep-id:uid=65532,gid=65532
Network=makersbrain.network
@@CATALOGUE_NETWORK@@
Volume=/etc/makersbrain/secrets/cloudflared:/run/secrets:ro
Exec=tunnel --no-autoupdate --metrics 0.0.0.0:2000 run --token-file /run/secrets/tunnel-token
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=default.target
