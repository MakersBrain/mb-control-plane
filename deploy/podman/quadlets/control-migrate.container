[Unit]
Description=Apply MakersBrain control schema migrations
Requires=control-database-identities.service
After=control-database-identities.service
Before=control-api.service

[Container]
Image=@@CONTROL_IMAGE@@
Pull=never
UserNS=keep-id:uid=10001,gid=10001
Network=makersbrain.network
Environment=CONTROL_DATA_MODE=@@DATA_MODE@@
Environment=CONTROL_DEPLOYMENT_ENVIRONMENT=@@ENVIRONMENT@@
Environment=PGSSLMODE=verify-full
Environment=PGSSLROOTCERT=/run/secrets/postgres-ca.crt
EnvironmentFile=/etc/makersbrain/control-migrate.env
Volume=/etc/makersbrain/secrets/control-migrate:/run/secrets:ro
Volume=@@RUNTIME_SECRET_SOURCE@@/postgres-ca.crt:/run/secrets/postgres-ca.crt:ro
Exec=/usr/local/bin/control-migrate
NoNewPrivileges=true
DropCapability=all

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300
