[Unit]
Description=MakersBrain control API
Requires=control-migrate.service privacy-export-init.service
After=control-migrate.service privacy-export-init.service

[Container]
Image=@@CONTROL_IMAGE@@
Pull=never
ContainerName=control-api
GroupAdd=0
UserNS=keep-id:uid=10001,gid=10001
Network=makersbrain.network
Environment=CONTROL_DATA_MODE=@@DATA_MODE@@
Environment=CONTROL_DEPLOYMENT_ENVIRONMENT=@@ENVIRONMENT@@
Environment=PGSSLMODE=verify-full
Environment=PGSSLROOTCERT=/run/secrets/postgres-ca.crt
EnvironmentFile=/etc/makersbrain/control-api.env
Volume=/etc/makersbrain/secrets/control-api:/run/secrets:ro
Volume=@@RUNTIME_SECRET_SOURCE@@/postgres-ca.crt:/run/secrets/postgres-ca.crt:ro
Volume=privacy-exports.volume:/var/lib/makersbrain/privacy-exports
Volume=tenant-secrets.volume:/run/makersbrain-secrets:ro
Exec=/usr/local/bin/control-api
HealthCmd=/usr/bin/curl --fail --silent http://127.0.0.1:8080/health/ready
HealthInterval=15s
HealthRetries=12
HealthStartPeriod=20s
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=default.target
