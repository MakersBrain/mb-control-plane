[Unit]
Description=Initialize privacy export storage ownership
Before=control-api.container

[Container]
Image=@@ALPINE_IMAGE@@
Pull=never
Network=none
User=0:0
Volume=privacy-exports.volume:/exports
Exec=/bin/sh -ec "chown 10001:10001 /exports && chmod 0700 /exports"
NoNewPrivileges=true
DropCapability=all
AddCapability=CHOWN DAC_OVERRIDE FOWNER

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=60
