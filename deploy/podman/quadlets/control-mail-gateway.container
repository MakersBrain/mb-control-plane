[Unit]
Description=MakersBrain authenticated Scaleway TEM mail gateway

[Container]
Image=@@CONTROL_IMAGE@@
Pull=never
ContainerName=control-mail-gateway
UserNS=keep-id:uid=10001,gid=10001
Network=makersbrain.network
Environment=MAIL_GATEWAY_ENVIRONMENT=@@ENVIRONMENT@@
EnvironmentFile=/etc/makersbrain/control-mail-gateway.env
Volume=/etc/makersbrain/secrets/control-mail-gateway:/run/secrets:ro
Volume=%h/.config/containers/systemd/makersbrain/scaleway-sns-fr-par-trust-chain.pem:/etc/makersbrain/scaleway-sns-fr-par-trust-chain.pem:ro
Volume=mail-events.volume:/var/lib/makersbrain/mail-events
Exec=/usr/local/bin/control-mail-gateway
HealthCmd=/usr/bin/curl --fail --silent http://127.0.0.1:8080/health/live
HealthInterval=15s
HealthRetries=12
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=default.target
