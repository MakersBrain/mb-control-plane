[Unit]
Description=Wait for Rauthy readiness
Requires=rauthy.container
After=rauthy.container
Before=control-web.container cloudflared.container

[Container]
Image=@@ALPINE_IMAGE@@
Pull=never
Network=makersbrain.network
Exec=/bin/sh -ec "attempt=0; until wget -q -O /dev/null http://rauthy:8092/auth/v1/health; do attempt=$((attempt+1)); [ $attempt -lt 60 ] || exit 1; sleep 2; done"
NoNewPrivileges=true
DropCapability=all

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=130

[Install]
WantedBy=default.target
