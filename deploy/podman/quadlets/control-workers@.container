[Unit]
Description=MakersBrain control worker for %i
Requires=control-migrate.container privacy-export-init.container
After=control-migrate.container privacy-export-init.container

[Container]
Image=@@CONTROL_IMAGE@@
Pull=never
ContainerName=control-worker-%i
GroupAdd=0
Network=makersbrain.network
Environment=CONTROL_DATA_MODE=@@DATA_MODE@@
Environment=CONTROL_DEPLOYMENT_ENVIRONMENT=@@ENVIRONMENT@@
Environment=PGSSLMODE=verify-full
Environment=PGSSLROOTCERT=/run/secrets/postgres-ca.crt
EnvironmentFile=/etc/makersbrain/control-worker-%i.env
Volume=/etc/makersbrain/secrets/control-worker-%i:/run/secrets:ro
Volume=@@RUNTIME_SECRET_SOURCE@@/postgres-ca.crt:/run/secrets/postgres-ca.crt:ro
Exec=/usr/local/bin/control-worker %i
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
