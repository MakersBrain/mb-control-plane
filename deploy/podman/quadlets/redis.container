[Unit]
Description=MakersBrain shared Redis

[Container]
Image=@@REDIS_IMAGE@@
Pull=never
ContainerName=redis
User=999:1000
UserNS=keep-id:uid=999,gid=1000
Network=makersbrain.network
Volume=redis-data.volume:/data
Exec=redis-server --appendonly yes --appendfsync everysec --maxmemory-policy noeviction
HealthCmd=redis-cli ping
HealthInterval=10s
HealthRetries=12
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
