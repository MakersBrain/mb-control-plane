[Unit]
Description=MakersBrain private PostgreSQL runtime

[Container]
Image=@@POSTGRES_IMAGE@@
Pull=never
ContainerName=makersbrain-postgres
PublishPort=@@PRIVATE_BIND_IP@@:5432:5432
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres_superuser_password
Environment=CONTROL_POSTGRES_PASSWORD=@/run/secrets/control_postgres_password
Environment=CONTROL_API_POSTGRES_PASSWORD=@/run/secrets/control_api_postgres_password
Environment=CONTROL_MEMBERSHIP_POSTGRES_PASSWORD=@/run/secrets/control_membership_postgres_password
Environment=CONTROL_PROVISIONING_POSTGRES_PASSWORD=@/run/secrets/control_provisioning_postgres_password
Environment=CONTROL_INVOICE_POSTGRES_PASSWORD=@/run/secrets/control_invoice_postgres_password
Environment=CONTROL_INVENTORY_POSTGRES_PASSWORD=@/run/secrets/control_inventory_postgres_password
Environment=CONTROL_EMAIL_POSTGRES_PASSWORD=@/run/secrets/control_email_postgres_password
Environment=CONTROL_RECONCILIATION_POSTGRES_PASSWORD=@/run/secrets/control_reconciliation_postgres_password
Environment=CONTROL_LIFECYCLE_POSTGRES_PASSWORD=@/run/secrets/control_lifecycle_postgres_password
Environment=CONTROL_BACKUP_POSTGRES_PASSWORD=@/run/secrets/control_backup_postgres_password
Environment=CONTROL_DRIVER_POSTGRES_PASSWORD=@/run/secrets/control_driver_postgres_password
Environment=CONTROL_RELEASE_POSTGRES_PASSWORD=@/run/secrets/control_release_postgres_password
Environment=CONTROL_PRIVACY_POSTGRES_PASSWORD=@/run/secrets/control_privacy_postgres_password
Environment=RAUTHY_POSTGRES_PASSWORD=@/run/secrets/rauthy_postgres_password
Environment=ODOO_POSTGRES_PASSWORD=@/run/secrets/odoo_postgres_password
Volume=@@DATA_DIRECTORY@@:/var/lib/postgresql/data
Volume=./init-databases.sh:/docker-entrypoint-initdb.d/01-databases.sh:ro
Volume=./pg_hba.conf:/etc/postgresql/pg_hba.conf:ro
Secret=postgres_superuser_password,target=postgres_superuser_password,uid=70,gid=70,mode=0400
Secret=control_postgres_password,target=control_postgres_password,uid=70,gid=70,mode=0400
Secret=control_api_postgres_password,target=control_api_postgres_password,uid=70,gid=70,mode=0400
Secret=control_membership_postgres_password,target=control_membership_postgres_password,uid=70,gid=70,mode=0400
Secret=control_provisioning_postgres_password,target=control_provisioning_postgres_password,uid=70,gid=70,mode=0400
Secret=control_invoice_postgres_password,target=control_invoice_postgres_password,uid=70,gid=70,mode=0400
Secret=control_inventory_postgres_password,target=control_inventory_postgres_password,uid=70,gid=70,mode=0400
Secret=control_email_postgres_password,target=control_email_postgres_password,uid=70,gid=70,mode=0400
Secret=control_reconciliation_postgres_password,target=control_reconciliation_postgres_password,uid=70,gid=70,mode=0400
Secret=control_lifecycle_postgres_password,target=control_lifecycle_postgres_password,uid=70,gid=70,mode=0400
Secret=control_backup_postgres_password,target=control_backup_postgres_password,uid=70,gid=70,mode=0400
Secret=control_driver_postgres_password,target=control_driver_postgres_password,uid=70,gid=70,mode=0400
Secret=control_release_postgres_password,target=control_release_postgres_password,uid=70,gid=70,mode=0400
Secret=control_privacy_postgres_password,target=control_privacy_postgres_password,uid=70,gid=70,mode=0400
Secret=rauthy_postgres_password,target=rauthy_postgres_password,uid=70,gid=70,mode=0400
Secret=odoo_postgres_password,target=odoo_postgres_password,uid=70,gid=70,mode=0400
Secret=postgres_tls_certificate,target=/run/secrets/postgres.crt,uid=70,gid=70,mode=0444
Secret=postgres_tls_private_key,target=/run/secrets/postgres.key,uid=70,gid=70,mode=0400
Secret=pgbackrest_config,target=/etc/pgbackrest/pgbackrest.conf,uid=70,gid=70,mode=0400
Exec=postgres -c listen_addresses=* -c password_encryption=scram-sha-256 -c ssl=on -c ssl_cert_file=/run/secrets/postgres.crt -c ssl_key_file=/run/secrets/postgres.key -c hba_file=/etc/postgresql/pg_hba.conf -c wal_level=replica -c archive_mode=on -c archive_timeout=60s -c "archive_command=pgbackrest --stanza=makersbrain archive-push %%p"
HealthCmd=pg_isready -U postgres -h 127.0.0.1
HealthInterval=10s
HealthRetries=20
HealthStartPeriod=30s
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=default.target
