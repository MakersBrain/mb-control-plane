{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": 1,
  "release": "0.1.0",
  "schema_release": "0003_odoo_database_lifecycle",
  "schema_compatibility": ">=0003_odoo_database_lifecycle,<0004",
  "images": {
    "control": {"build_context": "control-plane", "dockerfile": "Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]},
    "web": {"build_context": "control-plane/web", "dockerfile": "Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]},
    "odoo": {"build_context": ".", "dockerfile": "control-plane/deploy/Odoo.Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]}
  },
  "processes": {
    "migration": {"command": ["/usr/local/bin/control-migrate"], "run_before": ["api", "workers"]},
    "api": {"command": ["/usr/local/bin/control-api"], "port": 8080, "live": "/health/live", "ready": "/health/ready", "openapi": "/openapi.json"},
    "workers": {"executable": "/usr/local/bin/control-worker", "queues": ["identity-operations", "tenant-provisioning", "membership-provisioning", "invoice-capture", "email-delivery", "tenant-reconciliation", "tenant-lifecycle"]},
    "web": {"port": 8080, "live": "/health/live"}
  },
  "required_environment": {
    "migration": ["CONTROL_DATABASE_URL"],
    "api": ["CONTROL_LISTEN", "CONTROL_DATABASE_URL", "CONTROL_PUBLIC_ORIGIN", "CONTROL_CORS_ORIGIN", "CONTROL_OIDC_ISSUER", "CONTROL_OIDC_AUDIENCE", "CONTROL_OIDC_DISCOVERY_URL", "CONTROL_TENANT_DOMAIN", "CONTROL_INTERNAL_TOKEN"],
    "membership_worker": ["CONTROL_DATABASE_URL", "CONTROL_RAUTHY_ADMIN_URL", "CONTROL_RAUTHY_ADMIN_KEY", "CONTROL_SECRET__<TENANT_ODOO_REF>", "CONTROL_SECRET__<TENANT_PAPERLESS_REF>"],
    "invoice_worker": ["CONTROL_DATABASE_URL", "CONTROL_AZURE_ENDPOINT", "CONTROL_AZURE_KEY", "CONTROL_AZURE_API_VERSION", "CONTROL_AZURE_MONTHLY_PAGE_LIMIT", "CONTROL_AZURE_ANALYZE_MIN_INTERVAL_MS", "CONTROL_AZURE_POLL_INTERVAL_MS", "CONTROL_SECRET__<TENANT_ODOO_REF>", "CONTROL_SECRET__<TENANT_PAPERLESS_REF>"],
    "provisioning_worker": ["CONTROL_DATABASE_URL", "CONTROL_DEPLOYMENT_DRIVER_URL", "CONTROL_DEPLOYMENT_DRIVER_TOKEN"],
    "email_worker": ["CONTROL_DATABASE_URL", "CONTROL_MAIL_WEBHOOK_URL", "CONTROL_MAIL_WEBHOOK_TOKEN"]
  },
  "volumes": {
    "control": ["postgresql_database"],
    "odoo_tenant": ["postgresql_database", "filestore"],
    "paperless_tenant": ["postgresql_database", "data", "media", "consume", "redis"]
  },
  "identity": {"provider": "rauthy", "tested_version": "0.36.1", "client_manifest": "rauthy-client.schema.json", "required_flow": "authorization_code+PKCE(S256)", "human_local_passwords": false},
  "development_tunnel": {"connector": "cloudflared:2026.7.2", "domain_pattern": "*.dev[1-4].makersbrain.net", "infrastructure_root": "../makersbrain-infra/environments/development/developer-tunnels", "synthetic_data_only": true},
  "paperless": {"tested_version": "2.20.15", "api_prefix": "/api", "oidc_provider": "openid_connect", "document_event": "/internal/v1/paperless/{workshop_id}/events"},
  "odoo": {"version": "19", "modules": ["auth_oidc@OCA/server-auth:f51fe1b36965b78ac935e80c6b95d7115440a1b4", "mb_control_bridge", "mb_invoice_capture"], "bridge_prefix": "/mb_control/v1", "database_per_tenant": true, "native_database_manager": false, "tenant_hostname_pattern": "<workshop-slug>.<CONTROL_TENANT_DOMAIN>", "database_identifier_pattern": "mb_<opaque-uuid>", "routing_contract": "deployment gateway resolves an exact registered hostname to an isolated tenant process; hostname and database identifier are never derived from one another"},
  "rollback": {"application": "previous image is compatible while schema remains 0001_control_plane", "database": "forward repair only after migration adoption; restore the paired backup for destructive recovery"}
}
