{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": 2,
  "application_release_schema": "application-release.schema.json",
  "public_openapi_baseline": "openapi-v1-baseline.json",
  "capability_registry": {"path":"capability-registry-v2.json","version":2,"sha256":"aa813da17839d8448d9b065ccb741bf01ac96ef178471c7801561910bf9aeb91"},
  "release": "0.1.0",
  "schema_release": "0039_webshop_onboarding",
  "schema_compatibility": ">=0024_worker_heartbeats,<0025",
  "staging_qualification": {
    "builder": "podman/qualification.py",
    "environment": "synthetic-only staging",
    "mandatory_checks": ["release_verification", "topology_reboot", "two_tenant_isolation", "queue_workers", "release_adoption", "failed_upgrade_fencing", "rollback", "provider_failure_recovery", "webshop_cloudflare_dns_tls", "webshop_scaleway_mail", "webshop_sumup_payment", "webshop_boxtal_shipping", "webshop_browser_accessibility", "identity_mfa", "mail_delivery", "backup_restore", "erasure_restore_replay", "migration_rehearsal", "alerts_runbooks", "observability_delivery", "load_test", "log_privacy_review"],
    "promotion_input": "signed immutable OCI qualification artifact bound to the exact release image map"
  },
  "images": {
    "control": {"build_context": "control-plane", "dockerfile": "Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]},
    "web": {"build_context": "control-plane/web", "dockerfile": "Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]},
    "odoo": {"build_context": ".", "dockerfile": "control-plane/deploy/Odoo.Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]},
    "paperless": {"build_context": "control-plane/deploy", "dockerfile": "Paperless.Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]},
    "backup": {"build_context": "control-plane/deploy", "dockerfile": "Backup.Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]},
    "postgres": {"build_context": "control-plane/deploy", "dockerfile": "Postgres.Dockerfile", "required_artifacts": ["oci_digest", "spdx_sbom"]}
  },
  "processes": {
    "migration": {"command": ["/usr/local/bin/control-migrate"], "run_before": ["api", "workers"]},
    "database_identity_reconciliation": {"command": ["/bin/sh", "/run/makersbrain/reconcile-database-identities.sh"], "run_before": ["migration"], "idempotent": true},
    "privacy_export_volume_initialization": {"command": ["/bin/sh", "-ec", "chown 10001:10001 /exports && chmod 0700 /exports"], "run_before": ["api", "privacy_worker"], "idempotent": true},
    "api": {"command": ["/usr/local/bin/control-api"], "port": 8080, "live": "/health/live", "ready": "/health/ready", "openapi": "/openapi.json"},
    "workers": {"executable": "/usr/local/bin/control-worker", "queues": ["tenant-provisioning", "membership-provisioning", "invoice-capture", "inventory-capture", "email-delivery", "tenant-reconciliation", "tenant-lifecycle", "release-adoption", "privacy-operations"]},
    "web": {"port": 8080, "live": "/health/live"},
    "docker_driver": {"command": ["/usr/local/bin/control-container-driver"], "port": 8080, "live": "/health/live", "private": true},
    "backup_scheduler": {"command": ["/usr/local/bin/control-backup-scheduler"], "private": true, "cadence": "one due backup per workshop per 24 hours and one isolated recovery rehearsal per 30 days"}
    ,"document_extraction_broker": {"command": ["/usr/local/bin/document-extraction-broker"], "port": 8080, "live": "/health/live", "private": true, "allowed_models": ["prebuilt-invoice", "prebuilt-read"]}
    ,"mail_gateway": {"command": ["/usr/local/bin/control-mail-gateway"], "port": 8080, "live": "/health/live", "private": true, "provider": "Scaleway TEM fr-par", "staging_recipient_policy": "exact protected allowlist"}
  },
  "secret_delivery": {
    "local_transport": "Compose secret files mounted by exact process ownership",
    "runtime_reference_prefix": "@/run/secrets/",
    "rendered_configuration_gate": "tools/test_compose_secret_canary.py",
    "production_transport": "approved secret-manager references resolved by the infrastructure driver",
    "plaintext_in_rendered_configuration": false
  },
  "observability": {
    "metrics_path": "/internal/metrics",
    "authentication": "CONTROL_INTERNAL_TOKEN",
    "traces": {
      "protocol": "OTLP/HTTP protobuf",
      "enabled_when": "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT or OTEL_EXPORTER_OTLP_ENDPOINT is non-empty",
      "privacy_safe_span_attributes": ["service.name", "http_request_method", "http_route", "operation_id", "operation_kind", "attempt", "reconciling"],
      "durable_propagation_fields": ["control.operations.trace_parent", "control.operations.trace_state"],
      "events_exported": false,
      "required_region": "EEA"
    },
    "privacy_safe_labels": ["templated_route", "status_class", "queue", "release_adoption_state", "provider", "provider_operation", "provider_outcome", "integration", "integration_health"],
    "forbidden_labels": ["email", "subject", "workshop_id", "operation_id", "token", "provider_payload"],
    "prometheus_rules": "prometheus-alerts.yml",
    "runbooks": [
      "../docs/runbooks/queue-and-worker-failure.md",
      "../docs/runbooks/failed-release-adoption.md",
      "../docs/runbooks/failed-restore.md",
      "../docs/runbooks/credential-rotation.md",
      "../docs/runbooks/webshop-paid-release-qualification.md"
    ]
  },
  "required_environment": {
    "migration": ["CONTROL_DATABASE_URL", "CONTROL_DATA_MODE"],
    "api": ["CONTROL_LISTEN", "CONTROL_DATABASE_URL", "CONTROL_DATA_MODE", "CONTROL_PUBLIC_ORIGIN", "CONTROL_CORS_ORIGIN", "CONTROL_OIDC_ISSUER", "CONTROL_OIDC_AUDIENCE", "CONTROL_OIDC_DISCOVERY_URL", "CONTROL_TENANT_DOMAIN", "CONTROL_INTERNAL_TOKEN", "CONTROL_MAIL_EVENT_TOKEN", "CONTROL_RELEASE_PUBLISH_TOKEN", "CONTROL_INVITATION_SIGNING_KEY_ID", "CONTROL_INVITATION_VERIFICATION_KEYS_FILE", "CONTROL_DEPLOYMENT_DRIVER_URL", "CONTROL_DEPLOYMENT_DRIVER_TOKEN", "CONTROL_EXTRACTION_BROKER_URL", "CONTROL_EXTRACTION_BROKER_TOKEN", "CONTROL_PRIVACY_EXPORT_KEY_ID", "CONTROL_PRIVACY_EXPORT_KEY", "CONTROL_PRIVACY_EXPORT_ROOT", "CONTROL_SECRET_ROOT"],
    "membership_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_RAUTHY_ADMIN_URL", "CONTROL_RAUTHY_ADMIN_KEY", "CONTROL_SECRET_ROOT", "CONTROL_PAPERLESS_SECRET_ROOT"],
    "invoice_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_TENANT_DOMAIN", "CONTROL_SECRET_ROOT", "CONTROL_PAPERLESS_SECRET_ROOT", "CONTROL_EXTRACTION_BROKER_URL", "CONTROL_EXTRACTION_BROKER_TOKEN"],
    "inventory_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_SECRET_ROOT", "CONTROL_EXTRACTION_BROKER_URL", "CONTROL_EXTRACTION_BROKER_TOKEN"],
    "document_extraction_broker": ["BROKER_LISTEN", "BROKER_TOKEN"],
    "mail_gateway": ["MAIL_GATEWAY_LISTEN", "MAIL_GATEWAY_ENVIRONMENT", "MAIL_GATEWAY_SCW_ENDPOINT", "MAIL_GATEWAY_SCW_PROJECT_ID", "MAIL_GATEWAY_SCW_DOMAIN_ID", "MAIL_GATEWAY_FROM_EMAIL", "MAIL_GATEWAY_FROM_NAME", "MAIL_GATEWAY_INTERNAL_TOKEN", "MAIL_GATEWAY_SCW_SECRET_KEY", "MAIL_GATEWAY_ALLOWED_RECIPIENTS_FILE", "MAIL_GATEWAY_SNS_TOPIC_ARN", "MAIL_GATEWAY_SNS_TRUST_CHAIN_FILE", "MAIL_GATEWAY_EVENT_JOURNAL_FILE", "MAIL_GATEWAY_CONTROL_EVENT_URL", "MAIL_GATEWAY_CONTROL_EVENT_TOKEN"],
    "provisioning_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_TENANT_DOMAIN", "CONTROL_DEPLOYMENT_DRIVER_URL", "CONTROL_DEPLOYMENT_DRIVER_TOKEN"],
    "docker_driver": ["DRIVER_ENVIRONMENT", "DRIVER_CONTAINER_RUNTIME", "DRIVER_RUNTIME_SOCKET", "DRIVER_LISTEN", "DRIVER_TOKEN", "DRIVER_PRIVACY_TOKEN", "DRIVER_DATABASE_URL", "DRIVER_POSTGRES_ADMIN_URL", "DRIVER_POSTGRES_HOST", "DRIVER_POSTGRES_PORT", "DRIVER_ODOO_POSTGRES_PASSWORD", "DRIVER_ODOO_BRIDGE_TOKEN", "DRIVER_ODOO_IMAGE", "DRIVER_POSTGRES_IMAGE", "DRIVER_RUNTIME_NETWORK", "DRIVER_ODOO_VOLUME", "DRIVER_ODOO_UID", "DRIVER_ODOO_GID", "DRIVER_BACKUP_VOLUME", "DRIVER_ODOO_DATA_ROOT", "DRIVER_BACKUP_ROOT", "DRIVER_REDIS_ADDRESS", "DRIVER_SECRET_ROOT", "DRIVER_ODOO_CLIENT_SECRET_ROOT", "DRIVER_PAPERLESS_CLIENT_SECRET_ROOT", "DRIVER_RUNTIME_SECRET_SOURCE", "DRIVER_JOB_SECRET_ROOT", "DRIVER_ROUTE_ROOT", "DRIVER_GATEWAY_CONTAINER", "DRIVER_ODOO_BASE_URL", "DRIVER_CONTROL_INTERNAL_URL", "DRIVER_RAUTHY_ADMIN_URL", "DRIVER_RAUTHY_ADMIN_KEY", "DRIVER_OIDC_ISSUER", "DRIVER_PUBLIC_SCHEME"],
    "backup_scheduler": ["CONTROL_DATABASE_URL", "CONTROL_DEPLOYMENT_DRIVER_URL", "CONTROL_DEPLOYMENT_DRIVER_TOKEN"],
    "email_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_MAIL_WEBHOOK_URL", "CONTROL_MAIL_WEBHOOK_TOKEN", "CONTROL_PUBLIC_ORIGIN", "CONTROL_INVITATION_SIGNING_KEY_ID", "CONTROL_INVITATION_SIGNING_KEYS_FILE"]
    ,"reconciliation_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_TENANT_DOMAIN", "CONTROL_DEPLOYMENT_DRIVER_URL", "CONTROL_DEPLOYMENT_DRIVER_TOKEN", "CONTROL_SECRET_ROOT"]
    ,"lifecycle_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_DEPLOYMENT_DRIVER_URL", "CONTROL_DEPLOYMENT_DRIVER_TOKEN", "CONTROL_PRIVACY_LOOKUP_KEY_ID", "CONTROL_PRIVACY_LOOKUP_KEY"]
    ,"release_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_DEPLOYMENT_DRIVER_URL", "CONTROL_DEPLOYMENT_DRIVER_TOKEN", "CONTROL_RELEASE_COSIGN_EXECUTABLE", "CONTROL_RELEASE_COSIGN_KEY_FILE", "CONTROL_RELEASE_SLSA_BUILDER_ID"]
    ,"privacy_worker": ["CONTROL_DATABASE_URL", "CONTROL_RELEASE_ID", "CONTROL_PRIVACY_LOOKUP_KEY_ID", "CONTROL_PRIVACY_LOOKUP_KEY", "CONTROL_PRIVACY_EXPORT_KEY_ID", "CONTROL_PRIVACY_EXPORT_KEY", "CONTROL_PRIVACY_EXPORT_ROOT", "CONTROL_PRIVACY_DRIVER_URL", "CONTROL_PRIVACY_DRIVER_TOKEN"]
  },
  "optional_environment": {
    "tenant_public_port": ["CONTROL_TENANT_PUBLIC_PORT"],
    "personal_data_governance": ["CONTROL_PRIVACY_CONTROLLER_REF", "CONTROL_PRIVACY_PROCESSING_RECORD_REF", "CONTROL_PRIVACY_RETENTION_APPROVAL_REF", "CONTROL_PRIVACY_PROCESSOR_REGISTER_REF", "CONTROL_PRIVACY_DPIA_APPROVAL_REF", "CONTROL_PRIVACY_PROCESSING_REGION"],
    "privacy_export_rotation": ["CONTROL_PRIVACY_EXPORT_DECRYPTION_KEYS_FILE"],
    "platform_operators": ["CONTROL_OPERATOR_EMAILS"],
    "azure_document_extraction": ["BROKER_AZURE_ENDPOINT", "BROKER_AZURE_KEY", "BROKER_AZURE_API_VERSION", "BROKER_AZURE_POLL_INTERVAL_MS", "CONTROL_AZURE_MONTHLY_PAGE_LIMIT", "CONTROL_AZURE_MONTHLY_IMAGE_LIMIT", "CONTROL_AZURE_ANALYZE_MIN_INTERVAL_MS"],
    "inventory_vision_fallback": ["BROKER_VISION_PRIMARY", "BROKER_VISION_SECONDARY", "BROKER_OPENAI_ENDPOINT", "BROKER_OPENAI_KEY", "BROKER_OPENAI_MODEL", "BROKER_AZURE_MULTIMODAL_ENDPOINT", "BROKER_AZURE_MULTIMODAL_KEY", "BROKER_AZURE_MULTIMODAL_MODEL", "BROKER_GEMINI_ENDPOINT", "BROKER_GEMINI_KEY", "BROKER_GEMINI_MODEL", "BROKER_CLAUDE_ENDPOINT", "BROKER_CLAUDE_KEY", "BROKER_CLAUDE_MODEL", "BROKER_VISION_ENDPOINT", "BROKER_VISION_KEY", "BROKER_VISION_MODEL", "CONTROL_INVENTORY_AI_MONTHLY_IMAGE_LIMIT"],
    "inventory_product_lookup": ["BROKER_UPCITEMDB_ENDPOINT", "BROKER_UPCITEMDB_KEY"],
    "custom_hostname_provider": ["CONTROL_CLOUDFLARE_API_TOKEN", "CONTROL_CLOUDFLARE_ZONE_ID"],
    "branded_email_domain_provider": ["CONTROL_MAIL_SCW_PROJECT_ID", "CONTROL_MAIL_SCW_SECRET_KEY", "CONTROL_MAIL_SNS_TOPIC_ARN"],
    "paperless": ["DRIVER_PAPERLESS_IMAGE"],
    "production_database_tls": ["CONTROL_DEPLOYMENT_ENVIRONMENT", "DRIVER_POSTGRES_CA_SOURCE"],
    "portable_backups": ["DRIVER_BACKUP_AGENT_IMAGE", "BACKUP_S3_BUCKET", "BACKUP_S3_ENDPOINT", "BACKUP_S3_REGION", "BACKUP_S3_ACCESS_KEY_ID", "BACKUP_S3_SECRET_ACCESS_KEY", "RESTORE_S3_ACCESS_KEY_ID", "RESTORE_S3_SECRET_ACCESS_KEY", "BACKUP_AGE_RECIPIENT", "BACKUP_AGE_IDENTITY_FILE", "BACKUP_ENCRYPTION_KEY_ID", "BACKUP_RETENTION_DAYS", "CONTROL_BACKUP_SCHEDULER_ENABLED", "CONTROL_BACKUP_INTERVAL_SECONDS"],
    "opentelemetry": ["OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "OTEL_EXPORTER_OTLP_HEADERS", "OTEL_EXPORTER_OTLP_TRACES_HEADERS", "OTEL_TRACES_SAMPLER", "OTEL_TRACES_SAMPLER_ARG"]
  },
  "database_roles": {
    "migration": "control",
    "api": "control_api",
    "membership_worker": "control_membership_worker",
    "provisioning_worker": "control_provisioning_worker",
    "invoice_worker": "control_invoice_worker",
    "inventory_worker": "control_inventory_worker",
    "email_worker": "control_email_worker",
    "reconciliation_worker": "control_reconciliation_worker",
    "lifecycle_worker": "control_lifecycle_worker",
    "backup_scheduler": "control_backup_scheduler",
    "release_worker": "control_release_worker",
    "privacy_worker": "control_privacy_worker",
    "docker_driver": "control_driver_ledger"
  },
  "volumes": {
    "control": ["postgresql_database"],
    "privacy_exports": ["shared_api_privacy_worker_aead_artifacts", "seven_day_maximum", "single_use_cleanup"],
    "odoo_shared": ["postgresql_cluster", "filestore", "tenant_bridge_client_credentials"],
    "paperless_tenant": ["postgresql_database", "data", "media", "consume"],
    "redis_shared": ["append_only_data"]
  },
  "identity": {"provider": "rauthy", "tested_version": "0.36.1", "client_manifest": "rauthy-client.schema.json", "required_flow": "authorization_code+PKCE(S256)", "human_local_passwords": false},
  "development_tunnel": {"connector": "cloudflared:2026.7.2", "domain_pattern": "*.dev[1-4].makersbrain.net", "infrastructure_root": "../makersbrain-infra/environments/development/developer-tunnels", "synthetic_data_only": true},
  "paperless": {"optional_module": "documents", "tested_version": "2.20.15", "deployment": "one container and PostgreSQL database per enabled workshop", "redis": "one shared Redis with a unique ACL user and key/channel prefix per workshop", "api_prefix": "/api", "oidc_provider": "openid_connect", "document_event": "/internal/v1/paperless/{workshop_id}/events"},
  "invoice_capture": {"optional_module": "invoice-capture", "depends_on": ["documents"], "azure_module": "azure-invoice-extraction", "azure_optional": true},
  "inventory_capture": {"optional_module": "inventory-capture", "azure_module": "azure-label-extraction", "azure_optional": true, "source_images_in_queue": false},
  "odoo": {"version": "19", "deployment": "one shared Odoo process with one opaque PostgreSQL database per workshop", "core_modules": ["auth_oidc@OCA/server-auth:f51fe1b36965b78ac935e80c6b95d7115440a1b4", "mb_dbfilter_gateway", "mb_control_bridge", "mb_brand", "mb_workshop_pos"], "optional_modules": ["mb_ai_bridge", "mb_invoice_capture", "mb_inventory_capture", "mb_inventory_capture_catalogue", "mb_webshop", "mb_email_bridge", "mb_webshop_carrier_base", "mb_webshop_carrier_boxtal"], "bridge_prefix": "/mb_control/v1", "database_per_tenant": true, "native_database_manager": false, "tenant_hostname_pattern": "<workshop-slug>.<CONTROL_TENANT_DOMAIN>", "paperless_hostname_pattern": "docs-<workshop-slug>.<CONTROL_TENANT_DOMAIN>", "database_identifier_pattern": "mb_<opaque-uuid>", "routing_contract": "the gateway maps each exact registered hostname to an opaque Odoo database header; hostname and database identifier are never derived from one another; normal bridge requests require the distinct credential verifier stored in that selected tenant database"},
  "deployment_driver": {"implementations": {"development": "docker", "staging": "podman", "production": "podman"}, "runtime_selector": "DRIVER_CONTAINER_RUNTIME", "socket_variable": "DRIVER_RUNTIME_SOCKET", "network_variable": "DRIVER_RUNTIME_NETWORK", "authentication": "bearer", "idempotency": "persistent ledger", "socket": "private rootless Unix socket owned by the selected container runtime", "dynamic_resources": ["paperless_container", "paperless_volumes", "postgresql_databases", "redis_acl", "rauthy_clients", "gateway_routes", "encrypted_s3_recovery_sets"]},
  "rollback": {"application": "requires an application release compatible with 0024_worker_heartbeats", "database": "forward repair only after migration adoption; restore the verified workshop recovery set for destructive recovery"},
  "postgresql_recovery": {"tool": "podman/database/restore.py", "wal_archiving": "continuous encrypted pgBackRest repository", "incremental_backup": "daily", "full_backup": "weekly", "restore_drill": "isolated target directory; never overwrites the live cluster"}
}
