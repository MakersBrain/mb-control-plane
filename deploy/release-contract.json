      "tested_version": "1.148.0",
      "delivery": "mirror into the controlled registry, scan, generate SPDX SBOM and sign with the release key",
      "required_artifacts": [
        "oci_digest",
        "spdx_sbom"
      ],
      "source_repository": "MakersBrain/mb-infra"
    }
  },
  "processes": {
    "migration": {
      "command": [
        "/usr/local/bin/control-migrate"
      ],
      "run_before": [
        "api",
        "workers"
      ]
    },
    "database_identity_reconciliation": {
      "command": [
        "/bin/sh",
        "/run/mb/reconcile-database-identities.sh"
      ],
      "run_before": [
        "migration"
      ],
      "idempotent": true
    },
    "privacy_export_volume_initialization": {
      "command": [
        "/bin/sh",
        "-ec",
        "chown 10001:10001 /exports && chmod 0700 /exports"
      ],
      "run_before": [
        "api",
        "privacy_worker"
      ],
      "idempotent": true
    },
    "api": {
      "command": [
        "/usr/local/bin/control-api"
      ],
      "port": 8080,
      "live": "/health/live",
      "ready": "/health/ready",
      "openapi": "/openapi.json"
    },
    "workers": {
      "executable": "/usr/local/bin/control-worker",
      "queues": [
        "tenant-provisioning",
        "membership-provisioning",
        "invoice-capture",
        "inventory-capture",
        "email-delivery",
        "tenant-reconciliation",
        "tenant-lifecycle",
        "release-adoption",
        "privacy-operations"
      ]
    },
    "web": {
      "port": 8080,
      "live": "/health/live"
    },
    "docker_driver": {
      "command": [
        "/usr/local/bin/control-container-driver"
      ],
      "port": 8080,
      "live": "/health/live",
      "private": true
    },
    "backup_scheduler": {
      "command": [
        "/usr/local/bin/control-backup-scheduler"
      ],
      "private": true,
      "cadence": "one due backup per workshop per 24 hours and one isolated recovery rehearsal per 30 days"
    },
    "document_extraction_broker": {
      "command": [
        "/usr/local/bin/document-extraction-broker"
      ],
      "port": 8080,
      "live": "/health/live",
      "private": true,
      "allowed_models": [
        "prebuilt-invoice",
        "prebuilt-read"
      ]
    },
    "mail_gateway": {
      "command": [
        "/usr/local/bin/control-mail-gateway"
      ],
      "port": 8080,
      "live": "/health/live",
      "private": true,
      "provider": "Scaleway TEM fr-par",
      "staging_recipient_policy": "exact protected allowlist"
    }
  },
  "secret_delivery": {
    "local_transport": "Compose secret files mounted by exact process ownership",
    "runtime_reference_prefix": "@/run/secrets/",
    "rendered_configuration_gate": "tools/test_compose_secret_canary.py",
    "production_transport": "approved secret-manager references resolved by the infrastructure driver",
    "plaintext_in_rendered_configuration": false
  },
  "observability": {
    "metrics_path": "/internal/metrics",
    "authentication": "CONTROL_METRICS_TOKEN",
    "traces": {
      "protocol": "OTLP/HTTP protobuf",
      "enabled_when": "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT or OTEL_EXPORTER_OTLP_ENDPOINT is non-empty",
      "privacy_safe_span_attributes": [
        "service.name",
        "http_request_method",
        "http_route",
        "operation_id",
        "operation_kind",
        "attempt",
        "reconciling",
        "lifecycle_action"
      ],
      "durable_propagation_fields": [
        "control.operations.trace_parent",
        "control.operations.trace_state"
      ],
      "events_exported": false,
      "required_region": "EEA"
    },
    "privacy_safe_labels": [
      "templated_route",
      "status_class",
      "queue",
      "release_adoption_state",
      "provider",
      "provider_operation",
      "provider_outcome",
      "integration",
      "integration_health"
    ],
    "forbidden_labels": [
      "email",
      "subject",
      "workshop_id",
      "operation_id",
      "token",
      "provider_payload"
    ],
    "prometheus_rules": "prometheus-alerts.yml",
    "rule_evaluator": "central Prometheus reached through authenticated remote write",
    "runbooks": [
      "../docs/runbooks/queue-and-worker-failure.md",
      "../docs/runbooks/failed-release-adoption.md",
      "../docs/runbooks/failed-restore.md",
      "../docs/runbooks/credential-rotation.md",
      "../docs/runbooks/webshop-paid-release-qualification.md"
    ]
  },
