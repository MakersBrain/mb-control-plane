{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": 2,
  "application_release_schema": "application-release.schema.json",
  "capability_registry": {
    "path": "capability-registry.json",
    "version": 1,
    "sha256": "a6d49252dd8a990409c270c5b492c3922dbc95ae112fdddc77e60bf481f13273"
  },
  "release": "0.1.0",
  "schema_release": "0048_invitation_tenant_rls",
  "schema_compatibility": "=0048_invitation_tenant_rls",
  "staging_qualification": {
    "builder": "podman/qualification.py",
    "environment": "synthetic-only staging",
    "mandatory_checks": [
      "release_verification",
      "odoo_pair_verification",
      "official_runtime_read_only",
      "extension_preparation_failure",
      "topology_reboot",
      "driver_backend_contract",
      "driver_socket_isolation",
      "driver_interruption_reconciliation",
      "driver_gateway_fail_closed",
      "driver_one_shot_reboot",
      "driver_canary_leakage",
      "driver_static_rollback",
      "debian13_podman5",
      "two_tenant_isolation",
      "queue_workers",
      "release_adoption",
      "failed_upgrade_fencing",
      "rollback",
      "old_slot_garbage_collection",
      "provider_failure_recovery",
      "webshop_cloudflare_dns_tls",
      "webshop_scaleway_mail",
      "webshop_sumup_payment",
      "webshop_boxtal_shipping",
      "webshop_sendcloud_shipping",
      "webshop_browser_accessibility",
      "identity_mfa",
      "mail_delivery",
      "backup_restore",
      "erasure_restore_replay",
      "migration_rehearsal",
      "alerts_runbooks",
      "observability_delivery",
      "load_test",
      "log_privacy_review"
    ],
    "promotion_input": "signed immutable OCI qualification artifact bound to the exact release image map"
  },
  "images": {
    "control": {
      "build_context": ".",
      "dockerfile": "Dockerfile",
      "required_artifacts": [
        "oci_digest",
        "spdx_sbom"
      ],
      "source_repository": "MakersBrain/mb-control-plane"
    },
    "web": {
      "build_context": "web",
      "dockerfile": "Dockerfile",
      "required_artifacts": [
        "oci_digest",
        "spdx_sbom"
      ],
      "source_repository": "MakersBrain/mb-control-plane"
    },
    "odoo_runtime": {
      "delivery": "exact Docker Official Image subject with an observed SPDX SBOM, vulnerability report, and MakersBrain admission decision",
      "required_artifacts": [
        "oci_subject_digest",
        "platform_manifest_digest",
        "image_configuration_digest",
        "observed_spdx_sbom",
        "vulnerability_report"
      ],
      "source_repository": "odoo/docker"
    },
    "odoo_extension": {
      "delivery": "signed immutable MakersBrain addon and optional Python payload transport image",
      "required_artifacts": [
        "oci_subject_digest",
        "platform_manifest_digest",
        "image_configuration_digest",
        "payload_digest",
        "cosign_signature",
        "spdx_sbom",
        "vulnerability_report",
        "pair_qualification_digest"
      ],
      "source_repository": "MakersBrain/mb-odoo-addons"
    },
    "paperless": {
      "build_context": "deploy",
      "dockerfile": "Paperless.Dockerfile",
      "required_artifacts": [
        "oci_digest",
        "spdx_sbom"
      ],
      "source_repository": "MakersBrain/mb-control-plane"
    },
    "backup": {
      "build_context": "deploy",
      "dockerfile": "Backup.Dockerfile",
      "required_artifacts": [
        "oci_digest",
        "spdx_sbom"
      ],
      "source_repository": "MakersBrain/mb-control-plane"
    },
    "postgres": {
      "build_context": "deploy",
      "dockerfile": "Postgres.Dockerfile",
      "required_artifacts": [
        "oci_digest",
        "spdx_sbom"
      ],
      "source_repository": "MakersBrain/mb-control-plane"
    },
    "alpine": {
      "upstream_source": "docker.io/library/alpine@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce",
      "delivery": "mirror into the controlled registry, scan, generate SPDX SBOM and sign with the release key",
      "required_artifacts": [
        "oci_digest",
        "spdx_sbom"
      ],
      "source_repository": "MakersBrain/mb-infra"
    },
    "cloudflared": {
      "upstream_source": "docker.io/cloudflare/cloudflared@sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf",
      "delivery": "mirror into the controlled registry, scan, generate SPDX SBOM and sign with the release key",
