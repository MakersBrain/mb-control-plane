{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makersbrain.net/schemas/application-release-v1.json",
  "title": "MakersBrain immutable Odoo application release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "source_commit",
    "odoo_version",
    "image_digest",
    "built_at",
    "addons",
    "oca",
    "upgradeable_from",
    "database_runtime_compatibility",
    "bridge_contract",
    "schema_epoch",
    "change_class",
    "required_postconditions",
    "capability_registry_version",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {
      "type": "string",
      "pattern": "^odoo-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[a-f0-9]{7,64}$"
    },
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "odoo_version": {"type": "string", "pattern": "^[0-9]+\\.0$"},
    "image_digest": {"$ref": "#/$defs/sha256Digest"},
    "built_at": {"type": "string", "format": "date-time"},
    "addons": {"$ref": "#/$defs/versionMap"},
    "oca": {"$ref": "#/$defs/commitMap"},
    "upgradeable_from": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "database_runtime_compatibility": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"enum": ["none", "read-only", "read-write"]}
    },
    "bridge_contract": {"type": "string", "minLength": 1},
    "schema_epoch": {"type": "integer", "minimum": 1},
    "change_class": {"enum": ["A", "B", "C"]},
    "required_postconditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "registry_load",
          "installed_versions",
          "migration_ledger",
          "required_columns",
          "xmlid_ownership",
          "health"
        ]
      }
    },
    "capability_registry_version": {"type": "integer", "minimum": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oci_ref", "cosign_bundle_ref", "slsa_provenance_ref", "sbom_ref"],
      "properties": {
        "oci_ref": {"type": "string", "pattern": "^\\S+@sha256:[a-f0-9]{64}$"},
        "cosign_bundle_ref": {"type": "string", "minLength": 1},
        "slsa_provenance_ref": {"type": "string", "minLength": 1},
        "sbom_ref": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256Digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "versionMap": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9_]+$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "commitMap": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-zA-Z0-9_./-]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}
    }
  }
}
