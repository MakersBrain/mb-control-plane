CONTROL_POSTGRES_PASSWORD=replace-me
CONTROL_API_PORT=8080
CONTROL_WEB_PORT=4175
RAUTHY_HTTP_PORT=8092
ODOO_HTTP_PORT=8169
RAUTHY_HTTPS_PORT=18443
# Set to dev1.makersbrain.net (through dev4) for the tunnel profile.
PUBLIC_DOMAIN=
# Remotely managed Cloudflare Tunnel connector token; keep only in deploy/.env.
CLOUDFLARE_TUNNEL_TOKEN=
RAUTHY_POSTGRES_PASSWORD=replace-me
ODOO_POSTGRES_PASSWORD=replace-me
RAUTHY_ENC_KEYS=replace-with-date-slash-base64-key
RAUTHY_ENC_KEY_ACTIVE=replace-with-date
RAUTHY_BOOTSTRAP_ADMIN_EMAIL=owner@example.test
# Verified Rauthy accounts allowed to open the platform operator console.
CONTROL_OPERATOR_EMAILS=owner@example.test
RAUTHY_BOOTSTRAP_ADMIN_PASSWORD=replace-me
RAUTHY_HQL_SECRET_RAFT=replace-me
RAUTHY_HQL_SECRET_API=replace-me
CONTROL_INTERNAL_TOKEN=replace-me
ODOO_BRIDGE_TOKEN=replace-me
CONTROL_RAUTHY_ADMIN_KEY='makersbrain-runtime$replace-with-at-least-64-alphanumeric-characters'
CONTROL_RAUTHY_DEPLOYMENT_KEY='makersbrain-deployment$replace-with-at-least-64-alphanumeric-characters'
# Optional; required only when a workshop enables Azure invoice extraction.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
# Optional inventory-label AI. Choose one primary and, optionally, one distinct
# secondary provider: openai, azure, gemini, or claude. Configure all three
# endpoint/key/model values for every selected provider.
INVENTORY_VISION_PRIMARY=
INVENTORY_VISION_SECONDARY=
INVENTORY_OPENAI_ENDPOINT=https://api.openai.com/v1/responses
INVENTORY_OPENAI_KEY=
INVENTORY_OPENAI_MODEL=
INVENTORY_AZURE_MULTIMODAL_ENDPOINT=
INVENTORY_AZURE_MULTIMODAL_KEY=
INVENTORY_AZURE_MULTIMODAL_MODEL=
INVENTORY_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
INVENTORY_GEMINI_KEY=
INVENTORY_GEMINI_MODEL=
INVENTORY_CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
INVENTORY_CLAUDE_KEY=
INVENTORY_CLAUDE_MODEL=
# Deprecated: generic OpenAI Chat Completions-compatible endpoint.
INVENTORY_VISION_ENDPOINT=
INVENTORY_VISION_KEY=
INVENTORY_VISION_MODEL=
# Optional external barcode metadata. Trial endpoint has strict limits; production
# should use an approved paid endpoint/key or leave both values empty.
INVENTORY_UPCITEMDB_ENDPOINT=
INVENTORY_UPCITEMDB_KEY=
MAIL_WEBHOOK_URL=http://integration-fixture:8080/send
MAIL_WEBHOOK_TOKEN=replace-me
DEPLOYMENT_DRIVER_URL=http://docker-driver:8080
DEPLOYMENT_DRIVER_TOKEN=replace-me

# Configure every value below together to enable portable workshop backups.
# Writer credentials must not have delete/admin rights. Restore credentials are
# read-only and should be issued only for a restore window in production.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
BACKUP_S3_REGION=fr-par
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
RESTORE_S3_ACCESS_KEY_ID=
RESTORE_S3_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=/run/makersbrain-backup-secrets/age-identity.txt
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_RETENTION_DAYS=
CONTROL_BACKUP_SCHEDULER_ENABLED=false
CONTROL_BACKUP_INTERVAL_SECONDS=3600
