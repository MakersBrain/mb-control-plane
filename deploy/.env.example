# Secret values live in deploy/secrets/runtime. These references are safe to
# render; bootstrap-local-env.sh creates the corresponding 0400 files.
CONTROL_POSTGRES_PASSWORD=@/run/secrets/control_postgres_password
CONTROL_API_POSTGRES_PASSWORD=@/run/secrets/control_api_postgres_password
CONTROL_MEMBERSHIP_POSTGRES_PASSWORD=@/run/secrets/control_membership_postgres_password
CONTROL_PROVISIONING_POSTGRES_PASSWORD=@/run/secrets/control_provisioning_postgres_password
CONTROL_INVOICE_POSTGRES_PASSWORD=@/run/secrets/control_invoice_postgres_password
CONTROL_INVENTORY_POSTGRES_PASSWORD=@/run/secrets/control_inventory_postgres_password
CONTROL_EMAIL_POSTGRES_PASSWORD=@/run/secrets/control_email_postgres_password
CONTROL_RECONCILIATION_POSTGRES_PASSWORD=@/run/secrets/control_reconciliation_postgres_password
CONTROL_LIFECYCLE_POSTGRES_PASSWORD=@/run/secrets/control_lifecycle_postgres_password
CONTROL_BACKUP_POSTGRES_PASSWORD=@/run/secrets/control_backup_postgres_password
CONTROL_DRIVER_POSTGRES_PASSWORD=@/run/secrets/control_driver_postgres_password
CONTROL_RELEASE_POSTGRES_PASSWORD=@/run/secrets/control_release_postgres_password
CONTROL_PRIVACY_POSTGRES_PASSWORD=@/run/secrets/control_privacy_postgres_password
# AES-256-GCM key protecting durable processor lookup data. Rotation requires
# re-encrypting every retained lookup before switching the active key id.
CONTROL_PRIVACY_LOOKUP_KEY_ID=local-privacy-1
CONTROL_PRIVACY_LOOKUP_KEY=@/run/secrets/control_privacy_lookup_key
# Separate AES-256-GCM key for short-lived subject export archives.
CONTROL_PRIVACY_EXPORT_KEY_ID=local-export-1
CONTROL_PRIVACY_EXPORT_KEY=@/run/secrets/control_privacy_export_key
CONTROL_API_PORT=8080
CONTROL_WEB_PORT=4175
# Local fixtures are synthetic. Personal mode fails startup unless every
# controller-owned approval reference below is non-placeholder and the exact
# processing region is Paris/France Central or Azure West Europe.
CONTROL_DATA_MODE=synthetic
CONTROL_PRIVACY_CONTROLLER_REF=
CONTROL_PRIVACY_PROCESSING_RECORD_REF=
CONTROL_PRIVACY_RETENTION_APPROVAL_REF=
CONTROL_PRIVACY_PROCESSOR_REGISTER_REF=
CONTROL_PRIVACY_DPIA_APPROVAL_REF=
CONTROL_PRIVACY_PROCESSING_REGION=
RAUTHY_HTTP_PORT=8092
ODOO_HTTP_PORT=8169
RAUTHY_HTTPS_PORT=18443
# Set to dev1.makersbrain.net (through dev4) for the tunnel profile.
PUBLIC_DOMAIN=
# Remotely managed Cloudflare Tunnel connector token; keep only in deploy/.env.
CLOUDFLARE_TUNNEL_TOKEN=@/run/secrets/cloudflare_tunnel_token
CONTROL_CLOUDFLARE_API_TOKEN=@/run/secrets/control_cloudflare_api_token
CONTROL_MAIL_SCW_PROJECT_ID=00000000-0000-4000-8000-000000000000
CONTROL_MAIL_SCW_SECRET_KEY=@/run/secrets/control_mail_scw_secret_key
CONTROL_MAIL_SNS_TOPIC_ARN=arn:scw:sns:fr-par:00000000-0000-4000-8000-000000000000:makersbrain-mail
CONTROL_CLOUDFLARE_ZONE_ID=
RAUTHY_POSTGRES_PASSWORD=@/run/secrets/rauthy_postgres_password
ODOO_POSTGRES_PASSWORD=@/run/secrets/odoo_postgres_password
RAUTHY_ENC_KEYS=@/run/secrets/rauthy_enc_keys
RAUTHY_ENC_KEY_ACTIVE=replace-with-date
RAUTHY_BOOTSTRAP_ADMIN_EMAIL=owner@example.test
# Verified Rauthy accounts allowed to open the platform operator console.
CONTROL_OPERATOR_EMAILS=owner@example.test
RAUTHY_BOOTSTRAP_ADMIN_PASSWORD=@/run/secrets/rauthy_bootstrap_admin_password
RAUTHY_HQL_SECRET_RAFT=@/run/secrets/rauthy_hql_secret_raft
RAUTHY_HQL_SECRET_API=@/run/secrets/rauthy_hql_secret_api
CONTROL_INTERNAL_TOKEN=@/run/secrets/control_internal_token
# Read-only credential used only by Prometheus for the two metrics endpoints.
CONTROL_METRICS_TOKEN=@/run/secrets/control_metrics_token
CONTROL_MAIL_EVENT_TOKEN=@/run/secrets/control_mail_event_token
CONTROL_RELEASE_PUBLISH_TOKEN=@/run/secrets/control_release_publish_token
# Immutable control image/build identity used in durable worker-heartbeat evidence.
CONTROL_RELEASE_ID=replace-with-control-image-digest-or-signed-release-id
ODOO_BRIDGE_TOKEN=@/run/secrets/odoo_bridge_token
# Shared only by the control API/extraction workers and the private extraction
# broker. Generate a distinct random value; never reuse a provider API key.
DOCUMENT_EXTRACTION_TOKEN=@/run/secrets/document_extraction_token
INVITATION_SIGNING_KEY_ID=local-dev-1
CONTROL_RAUTHY_ADMIN_KEY=@/run/secrets/control_rauthy_admin_key
CONTROL_RAUTHY_DEPLOYMENT_KEY=@/run/secrets/control_rauthy_deployment_key
# Optional; required only when a workshop enables Azure invoice extraction.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=@/run/secrets/azure_document_key
# Optional inventory-label AI. Choose one primary and, optionally, one distinct
# secondary provider: openai, azure, gemini, or claude. Configure all three
# endpoint/key/model values for every selected provider.
INVENTORY_VISION_PRIMARY=
INVENTORY_VISION_SECONDARY=
INVENTORY_OPENAI_ENDPOINT=https://api.openai.com/v1/responses
INVENTORY_OPENAI_KEY=@/run/secrets/inventory_openai_key
INVENTORY_OPENAI_MODEL=
INVENTORY_AZURE_MULTIMODAL_ENDPOINT=
INVENTORY_AZURE_MULTIMODAL_KEY=@/run/secrets/inventory_azure_multimodal_key
INVENTORY_AZURE_MULTIMODAL_MODEL=
INVENTORY_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
INVENTORY_GEMINI_KEY=@/run/secrets/inventory_gemini_key
INVENTORY_GEMINI_MODEL=
INVENTORY_CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
INVENTORY_CLAUDE_KEY=@/run/secrets/inventory_claude_key
INVENTORY_CLAUDE_MODEL=
# Deprecated: generic OpenAI Chat Completions-compatible endpoint.
INVENTORY_VISION_ENDPOINT=
INVENTORY_VISION_KEY=@/run/secrets/inventory_vision_key
INVENTORY_VISION_MODEL=
# Optional external barcode metadata. Trial endpoint has strict limits; production
# should use an approved paid endpoint/key or leave both values empty.
INVENTORY_UPCITEMDB_ENDPOINT=
INVENTORY_UPCITEMDB_KEY=@/run/secrets/inventory_upcitemdb_key
MAIL_WEBHOOK_URL=http://integration-fixture:8080/send
MAIL_WEBHOOK_TOKEN=@/run/secrets/mail_webhook_token
DEPLOYMENT_DRIVER_URL=http://docker-driver:8080
DEPLOYMENT_DRIVER_TOKEN=@/run/secrets/deployment_driver_token
PRIVACY_DRIVER_TOKEN=@/run/secrets/privacy_driver_token
# Exact trusted SLSA builder identity used by the release-signing pipeline.
RELEASE_SLSA_BUILDER_ID=https://github.com/replace/repository/.github/workflows/release.yml@refs/heads/main

# Configure every value below together to enable portable workshop backups.
# Writer credentials must not have delete/admin rights. Restore credentials are
# read-only and should be issued only for a restore window in production.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://s3.fr-par.scw.cloud
BACKUP_S3_REGION=fr-par
BACKUP_S3_ACCESS_KEY_ID=@/run/secrets/backup_s3_access_key_id
BACKUP_S3_SECRET_ACCESS_KEY=@/run/secrets/backup_s3_secret_access_key
RESTORE_S3_ACCESS_KEY_ID=@/run/secrets/restore_s3_access_key_id
RESTORE_S3_SECRET_ACCESS_KEY=@/run/secrets/restore_s3_secret_access_key
BACKUP_AGE_RECIPIENT=@/run/secrets/backup_age_recipient
BACKUP_AGE_IDENTITY_FILE=/run/makersbrain-backup-secrets/age-identity.txt
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_RETENTION_DAYS=
CONTROL_BACKUP_SCHEDULER_ENABLED=false
CONTROL_BACKUP_INTERVAL_SECONDS=3600

# Optional OTLP trace export. Empty disables export; production should use an
# authenticated EEA collector and keep span attributes free of personal data.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
