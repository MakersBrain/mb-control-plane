CONTROL_POSTGRES_PASSWORD=replace-me
CONTROL_API_PORT=8080
CONTROL_WEB_PORT=4175
RAUTHY_HTTP_PORT=8092
ODOO_HTTP_PORT=8169
RAUTHY_HTTPS_PORT=18443
# Set to dev1.makersbrain.net (through dev4) for the tunnel profile.
PUBLIC_DOMAIN=
# Remotely managed Cloudflare Tunnel connector token; keep only in deploy/.env.
CLOUDFLARE_TUNNEL_TOKEN=
RAUTHY_POSTGRES_PASSWORD=replace-me
ODOO_POSTGRES_PASSWORD=replace-me
RAUTHY_ENC_KEYS=replace-with-date-slash-base64-key
RAUTHY_ENC_KEY_ACTIVE=replace-with-date
RAUTHY_BOOTSTRAP_ADMIN_EMAIL=owner@example.test
RAUTHY_BOOTSTRAP_ADMIN_PASSWORD=replace-me
RAUTHY_HQL_SECRET_RAFT=replace-me
RAUTHY_HQL_SECRET_API=replace-me
CONTROL_INTERNAL_TOKEN=replace-me
ODOO_BRIDGE_TOKEN=replace-me
CONTROL_RAUTHY_ADMIN_KEY='makersbrain-runtime$replace-with-at-least-64-alphanumeric-characters'
CONTROL_RAUTHY_DEPLOYMENT_KEY='makersbrain-deployment$replace-with-at-least-64-alphanumeric-characters'
# Optional; required only when a workshop enables Azure invoice extraction.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
MAIL_WEBHOOK_URL=http://integration-fixture:8080/send
MAIL_WEBHOOK_TOKEN=replace-me
DEPLOYMENT_DRIVER_URL=http://docker-driver:8080
DEPLOYMENT_DRIVER_TOKEN=replace-me
